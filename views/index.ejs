<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>create-user</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<style>
  body {
    height: 100vh;
    width: 100%;
    box-sizing: border-box;
  }
</style>

<body>
  <div class="flex flex-col w-[100%] h-[100%] pt-9 pl-9 bg-zinc-800">
    <h1 class=" pl-3 text-white pt-3 text-3xl">create user</h1>
    <div class=" pt-9 pl-3    ">
      <form action="/create-user" method="post">
        <input class=" text-zinc-400 rounded-lg w-50 py-2 px-5 bg-transparent outline-none border-2 border-zinc-600 "
          placeholder="enter name..." name="username" type="text">
        <input class=" text-zinc-400 rounded-lg w-50 py-2 px-5 bg-transparent outline-none border-2 border-zinc-600 "
          placeholder="enter email..." name="email" type="email">
        <input class=" text-zinc-400 rounded-lg w-50 py-2 px-5 bg-transparent outline-none border-2 border-zinc-600 "
          placeholder="enter password..." name="password" type="password">
        <input class=" text-zinc-400 rounded-lg w-50 py-2 px-5 bg-transparent outline-none border-2 border-zinc-600 "
          placeholder="enter age..." name="age" type="text">
        <input class=" text-zinc-100 rounded-lg w-30 py-2 px-2 bg-blue-700 outline-none border-none  " value="create-user" type="submit">
      </form>
    </div>

  </div>
</body>

</html>