<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>user-login</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<style>
  body {
    height: 100vh;
    width: 100%;
    box-sizing: border-box;
  }
</style>

<body>
  <div class="flex flex-col w-[100%] h-[100%] pt-9 pl-9 bg-zinc-800">
    <h1 class=" pl-3 text-white pt-3 text-3xl">Login your account</h1>
    <div class=" pt-9 pl-3    ">
      <form action="/login">
      <input class=" text-zinc-400 rounded-lg w-60 py-2 px-5 bg-transparent outline-none border-2 border-zinc-600 "
        placeholder="enter email..." name="email" type="text">
      <input class=" text-zinc-400 rounded-lg w-60 py-2 px-5 bg-transparent outline-none border-2 border-zinc-600 "
        placeholder="enter password..." name="password" type="password">
      <input class=" text-zinc-100 rounded-lg w-30 py-2 px-2 bg-blue-700 outline-none border-none  " 
      type="submit">
      </form>
      
    </div>

  </div>
</body>
</html>